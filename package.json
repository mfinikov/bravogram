{
  "name": "bravogram",
  "version": "0.1.1",
  "description": "Local memory shared by all your AI agents: CLI, MCP server and a graph view",
  "type": "module",
  "bin": {
    "bravogram": "dist/bin/bravogram.js"
  },
  "files": [
    "dist/bin",
    "dist/src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc && cp src/graph.html dist/src/",
    "test": "node --test \"test/*.test.ts\"",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "agents",
    "memory",
    "mcp",
    "claude",
    "sqlite",
    "knowledge-graph",
    "obsidian"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mfinikov/bravogram.git"
  },
  "homepage": "https://github.com/mfinikov/bravogram#readme",
  "bugs": "https://github.com/mfinikov/bravogram/issues",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.19.1",
    "typescript": "^7.0.2"
  }
}
